# Copie para .env e preencha. Nunca versione o .env.

# Octop (painel do cliente)
OCTOP_BASE_URL=http://IP-DA-VPS:8088
OCTOP_USERNAME=
OCTOP_PASSWORD=

# Hermes (na VPS do cliente)
HERMES_BASE_URL=http://IP-DA-VPS:9119
HERMES_USERNAME=
HERMES_PASSWORD=

# Tempo limite das chamadas, em milissegundos
REQUEST_TIMEOUT_MS=8000

# WhatsApp via Evolution API (instalada pelo time técnico)
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Segredo do caminho do webhook: POST /webhook/whatsapp/{WEBHOOK_SECRET}
WEBHOOK_SECRET=
